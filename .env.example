# MacroCockpit 2.0 environment variables (copy to .env and fill real values; NEVER commit .env)

# Public deployment & RBAC credentials
MACROCOCKPIT_PUBLIC_URL=https://news.shuashuabao.xyz
MACROCOCKPIT_ROLE=consumer
MACROCOCKPIT_TRUST_PROXY=1
MACROCOCKPIT_ACCESS_PASSWORD=
MACROCOCKPIT_READ_TOKEN=
MACROCOCKPIT_RW_TOKEN=
MACROCOCKPIT_SYNC_TOKEN=

# Optional overseas -> CN ingest override (defaults to ${MACROCOCKPIT_PUBLIC_URL}/api/v2/ingest-intl)
MACROCOCKPIT_INGEST_URL=

# Optional external data & knowledge paths
FRED_API_KEY=
RSSHUB_BASE_URL=
HERMES_HOME=
MACROCOCKPIT_NOTES_DIR=
NOTION_TOKEN=

# Personal mobile push targets (strictly DM only; group chat IDs are rejected)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ADMIN_OPEN_ID=
WECOM_WEBHOOK_URL=
SERVERCHAN_SENDKEY=
PUSHPLUS_TOKEN=
WXPUSHER_TOKEN=
NTFY_TOPIC_URL=
BARK_URL=
TG_BOT_TOKEN=
TG_CHAT_ID=
AGENT_ALERT_WEBHOOK_URL=
