[Unit]
Description=MacroCockpit Domestic Split Collector & Merger
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/macro-intel
Environment=PYTHONIOENCODING=utf-8
EnvironmentFile=/opt/macro-intel/.env
Environment=MACROCOCKPIT_ROOT=/opt/macro-intel
ExecStart=/usr/bin/python3 -m backend.cloud_collector --role cn-merge-publish
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
MemoryMax=384M
StandardOutput=journal
StandardError=journal
