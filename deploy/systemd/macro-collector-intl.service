[Unit]
Description=MacroCockpit Overseas Split Collector (Push Blocked Sources to CN Primary)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/macro-intel-intl
EnvironmentFile=/opt/macro-intel-intl/.env
ExecStart=/usr/bin/python3 -m backend.cloud_collector --role intl-push --producer-id overseas-vps-1
Nice=10
MemoryMax=384M
StandardOutput=journal
StandardError=journal
